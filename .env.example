# Copy to .env and fill in real values. Never commit the real .env file.

# --- Base Sepolia (testnet) — used for Hardhat deploys/tests and by api/resolve.js ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
ESCROW_CONTRACT_ADDRESS=

# --- api/resolve.js (Vercel serverless function) ---
# Read-only REST access to the Realtime Database (works while rules are in
# test/open mode; switch to the Firebase Admin SDK once rules are locked down).
FIREBASE_DATABASE_URL=
# The resolver wallet's private key. Must match the `resolver` address the
# ChessEscrow contract was deployed with. Set this as a Vercel *encrypted*
# env var — never commit it or log it.
RESOLVER_PRIVATE_KEY=

# --- Base mainnet — Phase 4 only, do not fill in until explicitly starting mainnet cutover ---
BASE_MAINNET_RPC_URL=https://mainnet.base.org
MAINNET_DEPLOYER_PRIVATE_KEY=

# Verified against Circle's official docs (developers.circle.com/stablecoins/usdc-contract-addresses):
# Base Sepolia USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base mainnet USDC:  0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Optional, only needed to verify contract source on the block explorer
BASESCAN_API_KEY=
